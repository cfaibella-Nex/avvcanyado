{
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "regions": ["fra1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'" }
      ]
    },
    {
      "source": "/assets/(fonts|img)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/actualitat", "destination": "/activitats", "permanent": true },
    { "source": "/participa-hi", "destination": "/participa", "permanent": true },
    { "source": "/espais", "destination": "/participa#local", "permanent": true },
    { "source": "/la-g%C3%A0bia-b%C3%A0squet", "destination": "/la-gabia", "permanent": true },
    { "source": "/activitats-a-la-mas%C3%ADa/:slug*", "destination": "/activitats#anteriors", "permanent": true }
  ]
}
